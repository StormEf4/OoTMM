{
  "name": "root",
  "private": true,
  "scripts": {
    "nx": "nx",
    "preinstall": "npx only-allow pnpm",
    "start": "nx run @ootmm/generator:start",
    "start:config": "nx run @ootmm/generator:start:config",
    "build": "nx run @ootmm/gui:build",
    "test": "nx run-many --parallel --output-style=stream --target=test",
    "typecheck": "nx run-many -t typecheck",
    "gui:dev": "nx run @ootmm/gui:dev",
    "web:dev": "nx run @ootmm/web:dev",
    "local": "nx run @ootmm/gui:dev",
    "local:ui": "pnpm --filter @ootmm/gui exec vite dev",
    "custom:add": "tsx scripts/custom.mts add",
    "custom:log": "tsx scripts/custom.mts log"
  },
  "dependencies": {
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/microtime": "catalog:",
    "@types/node": "catalog:",
    "glob": "catalog:",
    "microtime": "catalog:",
    "nx": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
